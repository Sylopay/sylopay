{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sylopay-api.vercel.app/api/:path*"
    },
    {
      "source": "/webhook/:path*",
      "destination": "https://sylopay-api.vercel.app/webhook/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
