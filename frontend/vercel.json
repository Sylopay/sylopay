{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-cpanel.vercel.app/api/:path*"
    },
    {
      "source": "/webhook/:path*",
      "destination": "https://backend-cpanel.vercel.app/webhook/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
